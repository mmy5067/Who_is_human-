PORT=3000
# The app enters demo mode while any API key is empty or a YOUR_ placeholder.
# Replace each endpoint / model with values provided by your API provider.
AGENT_1_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
AGENT_1_API_KEY=YOUR_ECNU_API_KEY_HERE
AGENT_1_MODEL=ecnu-max
AGENT_1_ENABLE_THINKING=false
AGENT_2_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_2_API_KEY=YOUR_ALIYUN_API_KEY_HERE
AGENT_2_MODEL=qwen3.7-plus
AGENT_2_ENABLE_THINKING=false
AGENT_3_BASE_URL=https://api.xiaomimimo.com/v1
AGENT_3_API_KEY=YOUR_XIAOMI_MIMO_API_KEY_HERE
AGENT_3_MODEL=mimo-v2.5-pro
AGENT_3_ENABLE_THINKING=false
DEMO_MODE=auto
# true = no model calls; false = force live mode; auto = check all three keys.
REQUEST_TIMEOUT_MS=20000
# Enable only behind one trusted reverse proxy; do not expose the Node port directly.
TRUST_PROXY=false
